{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portable learning relation v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "type": {
      "enum": [
        "covers",
        "contains",
        "related-to",
        "requires",
        "illustrates",
        "member-of",
        "inflection-of",
        "derivation-of",
        "contrasts-with",
        "revises"
      ]
    },
    "from": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "to": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sourceId",
          "locator"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "type",
    "from",
    "to",
    "status",
    "sourceRefs",
    "extensions"
  ],
  "additionalProperties": false
}
