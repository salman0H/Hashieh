        "type": "text",
        "version": 1,
        "data": {
          "format": "plain",
          "locale": "mixed",
          "text": "disabled\n\ndisabled = دارای معلولیت\n\nمثال:\n\nHe is a disabled man.\n\nاما در انگلیسی طبیعی‌تر، بسته به context:\n\nHe has a disability.",
          "role": "assistant-source"
