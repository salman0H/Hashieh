        "type": "text",
        "version": 1,
        "data": {
          "format": "plain",
          "locale": "mixed",
          "text": "frustrating\n\nfrustrating = ناامیدکننده / کلافه‌کننده\n\nچیزی که باعث frustration می‌شود:\n\nThe situation was frustrating.",
          "role": "assistant-source"
